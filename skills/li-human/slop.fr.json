  "structures": [
    {
      "id": "ce-nest-pas",
      "regex": "(?i)\\bce n'?est pas (?:juste|seulement|qu'?une?) [^.!?\n]{2,60}[,.] c'?est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dites la seule chose que vous pensez. Supprimez la mise en place."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\n]{2,80}\\bmais (?:aussi|également)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Deux phrases, ou gardez la moitié la plus forte."
    },
    {
      "id": "il-ne-sagit-pas",
      "regex": "(?i)\\bil ne s'?agit pas (?:de|d') [^.!?\n]{2,60}[.!,] il s'?agit (?:de|d')",
      "name": "« Il ne s'agit pas de X. Il s'agit de Y. »",
      "fix": "Commencez par Y. Le retournement trahit le modèle."
    },
    {
      "id": "le-resultat",
      "regex": "(?im)^\\s*(?:le résultat|la clé|le secret|la vérité|le plus fou|la suite|le hic)\\s*\\?\\s*$",
      "name": "Question rhétorique sur une ligne",
      "fix": "Répondez dans la phrase au lieu de mettre en scène la révélation."
    },
    {
      "id": "voici-ce-que",
      "regex": "(?i)\\bvoici (?:ce que j'ai appris|pourquoi|comment)\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Donnez la leçon. Sautez l'annonce."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
      "name": "Triade en trois temps",
      "fix": "Deux éléments ou quatre. Trois est le rythme par défaut du modèle."
    },
    {
      "id": "emoji-fusee",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji fusée / feu / ampoule / étincelle / cible",
      "fix": "Un emoji au plus, et pas l'un de ces cinq."
    },
    {
      "id": "emoji-puces",
      "regex": "(?m)^\\s*(?:👉|✅|➡️?|🔹|🔸)\\s",
      "name": "Puces en emoji (doigt, coche, flèche)",
      "fix": "Tirets simples ou phrases normales."
    },
    {
      "id": "mur-hashtags",
      "regex": "(?:#\\w+[ \t]*){5,}",
      "name": "Mur de hashtags (5+)",
      "fix": "Trois hashtags maximum."
    },
    {
      "id": "en-tant-quia",
      "regex": "(?i)\\ben tant qu'?(?:ia|intelligence artificielle|modèle de langage)\\b",
      "name": "Le modèle parle de lui",
      "fix": "Supprimez la phrase."
    },
    {
      "id": "en-conclusion",
      "regex": "(?im)^\\s*(?:en conclusion|en résumé|pour conclure|en somme|pour résumer)\\b",
      "name": "Ouverture de conclusion scolaire",
      "fix": "Un post n'a pas besoin de paragraphe de conclusion."
    },
    {
      "id": "appat-engagement",
      "regex": "(?i)(?:qu'?en pensez-vous|et vous\\s*\\?|dites-moi en commentaire|partagez[^.!?\n]{0,40}en commentaire|vos avis\\s*\\?|pensées\\s*\\?|d'accord\\s*\\?|qui d'autre\\b)",
      "name": "Appât à engagement réflexe",
      "fix": "Posez une question que seul ce post peut poser."
    },
    {
      "id": "spoiler",
      "regex": "(?i)\\b(?:petit )?spoiler\\s*:",
      "name": "« Spoiler : »",
      "fix": "Donnez l'info directement."
    },
    {
      "id": "nhesitez-pas",
      "regex": "(?i)\\bn'?hésitez pas à\\b",
      "name": "« N'hésitez pas à »",
      "fix": "Formule de courriel. Dites ce que la personne gagne à agir."
    }
  ]
}
