    {
      "id": "ar-laysa-mujarrad",
      "name": "\"ليس مجرد X، بل Y\"",
      "regex": "ليس(?:ت)?\\s+مجرد[^.!؟\\n]{2,60}[،,]?\\s*بل\\s",
      "fix": "Say Y directly. The 'not just X' half is padding."
    },
    {
      "id": "ar-laysa-faqat",
      "name": "\"ليس فقط X بل أيضا Y\"",
      "regex": "ليس\\s+فقط[^.!؟\\n]{2,80}بل\\s+(?:أيضا|أيضًا|أيضاً)",
      "fix": "Pick the stronger half and drop the other."
    },
    {
      "id": "ar-engagement-bait",
      "name": "Reflex engagement bait (ما رأيكم؟ / شاركونا آراءكم)",
      "regex": "(?:ما\\s+رأيكم\\s*[؟?]|شاركونا\\s+(?:آراءكم|رأيكم)|هل\\s+تتفقون\\s*[؟?])\\s*$",
      "fix": "Ask something specific only you could ask, or end on the point."
